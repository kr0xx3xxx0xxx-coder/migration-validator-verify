+# -*- coding: utf-8 -*-
+"""JOB-RECOVERY-STAGE1-PROGRESS-TIMESTAMP-AND-SAFE-DEFAULTS 회귀 테스트.
+
+검증 대상(services/exact_diff/reimport_job.py):
+  1. progress.last_progress_at 필드 존재 + update_progress 호출 시 갱신(엔진 발행 시각 우선)
+  2. _job_public / run_status 응답에 last_progress_at 노출
+  3. L1 정리 — 활성(_ACTIVE) job 의 실행 thread 가 죽었을 때 유예 경과 후 ORPHAN 확정 + store.finish_run
+  4. 회귀(가장 중요) — 정상 진행 중(thread alive) job 은 절대 건드리지 않는다
+"""
+from __future__ import annotations
+
+import threading
+import time
+
+import pytest
+
+from services.exact_diff import execution_settings as es
+from services.exact_diff import reimport_job as rj
+
+
+class _FakeStore:
+    """store.finish_run 호출만 기록하는 가짜 store(DB 접근 없음)."""
+
+    def __init__(self):
+        self.finished = []
+
+    def finish_run(self, run_id, **kw):
+        self.finished.append((run_id, kw))
+
+
+@pytest.fixture(autouse=True)
+def _clean():
+    rj.clear_all()
+    es.reset_execution_settings()
+    yield
+    rj.clear_all()
+    es.reset_execution_settings()
+
+
+def _mk_job(fp, run_id, hold: threading.Event, session="sessS1"):
+    """hold 가 set 될 때까지 PREPARING 을 유지하는 실제 thread job 1개."""
+    def _run(job):
+        rj.bind_run_id(job, run_id, {"session_id": session, "workflow_type": "INDIVIDUAL"})
+        hold.wait(timeout=30)
+        return {"status": "READY", "run_id": run_id}
+
+    return rj.start_or_attach(fingerprint=fp,
+                              meta={"session_id": session, "workflow_type": "INDIVIDUAL"},
+                              run_fn=_run)
+
+
+# ── 1. 진행 시각 기록 ──────────────────────────────────────────────────────────────────
+def test_new_progress_has_last_progress_at():
+    p = rj._new_progress()
+    assert "last_progress_at" in p and p["last_progress_at"] is None   # 발행 전엔 None
+
+
+def test_update_progress_stamps_time():
+    job = {"progress": rj._new_progress()}
+    t0 = time.time()
+    rj.update_progress(job, processed_src=10, processed_tgt=9)
+    ts = job["progress"]["last_progress_at"]
+    assert ts is not None and t0 <= ts <= time.time()
+    # 두 번째 호출에서 값이 전진(단조 증가)
+    time.sleep(0.01)
+    rj.update_progress(job, processed_src=20)
+    assert job["progress"]["last_progress_at"] > ts
+    assert job["progress"]["processed_source_count"] == 20   # 기존 카운트 동작 불변
+
+
+def test_update_progress_uses_engine_timestamp():
+    """엔진(_emit_prog)이 실은 progress_at 을 그대로 쓴다(호출 시각으로 덮어쓰지 않는다)."""
+    job = {"progress": rj._new_progress()}
+    fixed = 1700000000.5
+    rj.update_progress(job, processed_src=1, progress_at=fixed)
+    assert job["progress"]["last_progress_at"] == fixed
+
+
+def test_pk_range_chunk_emits_progress_at():
+    """pk_range_chunk._emit_prog 발행 payload 에 progress_at 이 실려 있는지(배선 계약)."""
+    import inspect
+
+    from services.exact_diff import pk_range_chunk as pc
+    src = inspect.getsource(pc.run_pk_range_chunk_compare)
+    assert '"progress_at": time.time()' in src
+
+
+# ── 2. 노출 ───────────────────────────────────────────────────────────────────────────
+def test_job_public_exposes_last_progress_at():
+    hold = threading.Event()
+    job = _mk_job("fpS1", "RUNS1", hold)
+    try:
+        time.sleep(0.2)
+        rj.update_progress(job, processed_src=5)
+        pub = rj._job_public(job)
+        assert "last_progress_at" in pub and pub["last_progress_at"] is not None
+        st = rj.run_status("RUNS1")
+        assert st["last_progress_at"] == pub["last_progress_at"]
+    finally:
+        hold.set()
+
+
+# ── 3. L1 정리(스레드 사망 시뮬레이션) ─────────────────────────────────────────────────
+def test_l1_reclaims_dead_thread_after_grace():
+    hold = threading.Event()
+    job = _mk_job("fpS2", "RUNS2", hold)
+    time.sleep(0.2)
+    hold.set()                       # worker 종료 → thread 사망
+    for _ in range(100):
+        if not job["thread"].is_alive():
+            break
+        time.sleep(0.02)
+    job["status"] = rj.PREPARING     # 강제 시뮬레이션: 상태만 활성으로 되돌린다(= thread 만 죽은 좀비)
+    job["finished_at"] = None
+    store = _FakeStore()
+
+    now = time.time()
+    # (a) 유예 내 재관측 — 아직 확정하지 않는다
+    assert rj.reclaim_dead_thread_jobs(now=now + 1, store=store) == []
+    assert job["status"] == rj.PREPARING and job.get("thread_dead_seen_at") is not None
+    assert rj.reclaim_dead_thread_jobs(now=now + 20, store=store) == []
+    assert job["status"] == rj.PREPARING          # 30초 유예 미경과 → 그대로
+
+    # (b) 유예(orphan_running_after_sec=30) 경과 → ORPHAN 확정
+    grace = es.get_execution_settings().recovery.orphan_running_after_sec
+    assert grace == 30
+    done = rj.reclaim_dead_thread_jobs(now=now + grace + 1, store=store)
+    assert done == ["RUNS2"]
+    assert job["status"] == rj.RECOVER_REQUIRED
+    assert job["recover_reason"] == rj.RECOVER_REASON_ORPHAN_RUNNING
+    assert job["orphan_confirmed_at"] is not None
+    assert store.finished and store.finished[0][0] == "RUNS2"
+    assert store.finished[0][1]["status"] == "ORPHANED"
+    # 더 이상 '진행 중'으로 보고되지 않는다(팝업/게이트 해제)
+    assert not any(r["run_id"] == "RUNS2" for r in rj.active_runs("sessS1"))
+
