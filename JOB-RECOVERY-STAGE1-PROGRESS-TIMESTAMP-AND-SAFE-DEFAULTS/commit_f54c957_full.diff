+def test_dead_seen_mark_cleared_when_alive_again():
+    """start() 직전 경계에서 죽은 것으로 관측돼도, 살아 있으면 표식이 즉시 지워진다(오탐 누적 없음)."""
+    hold = threading.Event()
+    job = {"status": rj.PREPARING, "started_at": time.time() - 999,
+           "thread": threading.Thread(target=lambda: hold.wait(timeout=10)),
+           "progress": rj._new_progress()}
+    rj._JOBS_BY_FP["fpS5"] = job
+    now = time.time()
+    rj.reclaim_dead_thread_jobs(now=now, store=_FakeStore())
+    assert job["thread_dead_seen_at"] is not None      # 아직 start() 전 → 죽은 것으로 관측
+    job["thread"].start()
+    try:
+        rj.reclaim_dead_thread_jobs(now=now + 1, store=_FakeStore())
+        assert job.get("thread_dead_seen_at") is None  # 살아난 시점에 표식 제거
+        # 표식이 지워졌으므로 유예가 처음부터 다시 시작된다(즉시 ORPHAN 확정되지 않는다)
+        assert rj.reclaim_dead_thread_jobs(now=now + 999, store=_FakeStore()) == []
+        assert job["status"] == rj.PREPARING
+    finally:
+        hold.set()
+        job["thread"].join(timeout=5)
+
