@@ -0,0 +1,289 @@
+# -*- coding: utf-8 -*-
+"""
+scripts/dev_e2e/job_recovery_stage1_progress_timestamp_verify.py
+
+JOB-RECOVERY-STAGE1-PROGRESS-TIMESTAMP-AND-SAFE-DEFAULTS 실측 드라이버 — 개발/테스트 전용(운영 파이프라인 아님).
+파이프라인상 위치: checker 계층(reimport_job / pk_range_chunk) + route 배선 종단 재현.
+
+실 DB(내부망 192.168.0.x / Neon) 이 모두 불통이라(§환경) 실 오라클·PG 종단 대신
+'실 엔진 + 실 route 함수(_run_pk_range_chunk) + 실 job 스레드' 를 in-process 로 구동해 재현한다.
+가짜인 것은 DB connection 과 chunk 조회 어댑터뿐이고, 진행신호 발행·throttle·job 갱신·폴링 경로는 전부 실제 코드다.
+
+측정 항목:
+  A. 재이관 job 진행 중 last_progress_at 이 실제로 갱신되는가(폴링 API rj.run_status 응답 기준) + 갱신 간격
+  B. L1 — 실행 thread 를 실제로 강제 종료(SystemExit 비동기 주입)시켰을 때 유예(30초) 후 ORPHAN 확정 + finish_run
+  C. 회귀 — 유예보다 오래 진행되는 '정상 job' 이 이번 변경으로 영향받지 않는가(가장 중요)
+
+사용법:  python scripts/dev_e2e/job_recovery_stage1_progress_timestamp_verify.py
+"""
+from __future__ import annotations
+
+import ctypes
+import json
+import os
+import sys
+import threading
+import time
+import types
+
+sys.path.insert(0, r"C:\projects\migration-validator")
+sys.stdout.reconfigure(encoding="utf-8")
+
+from services.exact_diff import execution_settings as es       # noqa: E402
+from services.exact_diff import pk_range_chunk as pc           # noqa: E402
+from services.exact_diff import reimport_job as rj             # noqa: E402
+from services.exact_diff import store as store_mod             # noqa: E402
+from services.exact_diff.store import ExactDiffRunStore        # noqa: E402
+
+SHOT = os.environ.get(
+    "MV_SHOT_DIR",
+    r"E:\verify_screenshots_only\JOB-RECOVERY-STAGE1-PROGRESS-TIMESTAMP-AND-SAFE-DEFAULTS")
+
+R: dict = {"driver": "job_recovery_stage1_progress_timestamp_verify", "results": {}}
+MEM_STORE = ExactDiffRunStore(memory=True)      # 운영 DB 파일 오염 방지(test-only in-memory)
+
+
+# ── 공통 — 가짜 DB connection / chunk 어댑터(실 엔진에 실 데이터 형태로 공급) ───────────────
+def _install_fake_db(rows_n: int, row_delay_ms: float = 0.0):
+    """route 가 쓰는 _pg_raw_connect 와 chunk 어댑터를 가짜로 교체한다(실 엔진 로직은 그대로).
+
+    row_delay_ms: chunk 조회 1회당 인위적 지연 — 실 DB read 대기를 모사해 진행신호 간격을 관측한다."""
+    from services.exact_diff import agg_contribution as agg_c
+
+    class _FakeConn:
+        def close(self):
+            pass
+
+    agg_c._pg_raw_connect = lambda conn: _FakeConn()
+
+    def _row(k, v):
+        return {"key": k, "gb": {}, "sum": {}, "cmp": {"V": v}}
+
+    SRC = {k: _row(k, str(k)) for k in range(1, rows_n + 1)}
+    # 값 불일치는 1,000행당 1건만 — 조기중단(임계 도달) 없이 chunk 루프를 끝까지 돌려 진행신호를 관측한다.
+    TGT = {k: _row(k, str(k + 1000) if k % 1000 == 0 else str(k)) for k in range(1, rows_n + 1)}
+
+    def _mk_fetch(_conn, _sql, _key, _gb, _sum, _labels, compare_cols=None):
+        data = SRC if _sql == "SRC" else TGT
+
+        def _f(a, b):
+            if row_delay_ms:
+                time.sleep(row_delay_ms / 1000.0)
+            return [data[k] for k in sorted(data) if a <= k < b]
+        return _f
+
+    adapter = (lambda d: d,                                     # output_alias(표시명 → alias)
+               lambda _c, _s, _k: (1, rows_n),                  # pk_min_max
+               _mk_fetch)
+    pc.get_chunk_fetch_adapter = lambda dbms: adapter
+    store_mod.default_exact_diff_store = lambda persist: MEM_STORE   # 운영 sqlite 미오염
+
+
+def _mk_req(rows_n: int, chunk_size: int):
+    """route(_run_pk_range_chunk)가 참조하는 최소 요청 객체 — 실제 필드 이름 그대로."""
+    return types.SimpleNamespace(
+        src_conn={"db_type": "postgresql", "host": "fake-src", "port": "5432", "dbname": "d"},
+        tgt_conn={"db_type": "postgresql", "host": "fake-tgt", "port": "5432", "dbname": "d"},
+        parse_result={"insert_cols": ["ID", "V"],
+                      "select_items": [{"tgt_col": "ID"}, {"tgt_col": "V"}]},
+        exclude_cols=[], gb_cols=[], chunk_size=chunk_size,
+        source_count=rows_n, target_count=rows_n)
+
+
+# ── A. 진행 중 last_progress_at 갱신 실측(폴링 API 응답 기준) ────────────────────────────
+def part_a():
+    print("\n" + "=" * 78)
+    print("[A] 재이관 job 진행 중 last_progress_at 갱신 실측 (실 엔진 + 실 route _pcb 배선)")
+    print("=" * 78)
+    import routes.agg_diff_route as agg
+
+    ROWS, CHUNK, DELAY_MS = 6000, 200, 400     # 30 chunk × 0.4초 지연 = 실 DB read 대기 모사(약 12초 실행)
+    _install_fake_db(ROWS, row_delay_ms=DELAY_MS)
+    rj.clear_all()
+
+    def _run_fn(job):
+        return agg._run_pk_range_chunk(_mk_req(ROWS, CHUNK), "SRC", "TGT", "ID", "ID", [], job,
+                                       fingerprint="")
+
+    job = rj.start_or_attach(fingerprint="fpA", meta={"session_id": "sessA",
+                                                      "workflow_type": "INDIVIDUAL",
+                                                      "query_summary": "stage1 verify"},
+                             run_fn=_run_fn)
+    # UI 와 동일하게 1초 폴링하며 API 응답(run_status)의 last_progress_at 만 본다.
+    samples, t0 = [], time.time()
+    run_id = None
+    while time.time() - t0 < 30:
+        run_id = run_id or job.get("run_id")
+        if run_id:
+            st = rj.run_status(run_id)
+            samples.append({"t": round(time.time() - t0, 2), "status": st.get("status"),
+                            "last_progress_at": st.get("last_progress_at"),
+                            "processed_source_count": st.get("processed_source_count")})
+            if st.get("status") not in rj._ACTIVE:
+                break
+        time.sleep(0.5)
+    job["thread"].join(timeout=30)
+
+    vals = [s["last_progress_at"] for s in samples if s["last_progress_at"] is not None]
+    distinct = sorted(set(vals))
+    gaps = [round(distinct[i + 1] - distinct[i], 3) for i in range(len(distinct) - 1)]
+    ok_present = bool(vals)
+    ok_advance = len(distinct) >= 3
+    ok_monotonic = all(vals[i] <= vals[i + 1] for i in range(len(vals) - 1))
+    R["results"]["A_last_progress_at"] = {
+        "rows": ROWS, "chunk_size": CHUNK, "chunk_delay_ms": DELAY_MS,
+        "final_status": job["status"], "poll_samples": len(samples),
+        "distinct_values": len(distinct), "gap_sec_min": (min(gaps) if gaps else None),
+        "gap_sec_max": (max(gaps) if gaps else None),
+        "first_sample": samples[0] if samples else None, "last_sample": samples[-1] if samples else None,
+        "api_field_present": ok_present, "advanced_during_run": ok_advance, "monotonic": ok_monotonic,
+        "verdict": "PASS" if (ok_present and ok_advance and ok_monotonic) else "FAIL",
+    }
+    print(f"  폴링 {len(samples)}회 / 서로 다른 last_progress_at {len(distinct)}개 / "
+          f"갱신간격 {min(gaps) if gaps else '-'}~{max(gaps) if gaps else '-'}초")
+    print(f"  최종 status={job['status']}  판정={R['results']['A_last_progress_at']['verdict']}")
+    return R["results"]["A_last_progress_at"]["verdict"] == "PASS"
+
+
+# ── B. L1 — 실행 thread 강제 종료 후 30초 유예 → ORPHAN 확정 ──────────────────────────
+def _kill_thread(t: threading.Thread):
+    """thread 에 SystemExit 를 비동기 주입 — _runner 의 except Exception 에 잡히지 않고 thread 가 즉사한다.
+    (실제 사고: worker 프로세스/스레드가 비정상 종료했지만 job 상태는 PREPARING 으로 남는 상황을 그대로 재현)"""
+    ctypes.pythonapi.PyThreadState_SetAsyncExc(ctypes.c_ulong(t.ident),
+                                               ctypes.py_object(SystemExit))
+
+
+def part_b():
+    print("\n" + "=" * 78)
+    print("[B] L1 — 실행 thread 강제 종료 후 유예 경과 시 ORPHAN 확정 (실시간 벽시계)")
+    print("=" * 78)
+    rj.clear_all()
+    grace = es.get_execution_settings().recovery.orphan_running_after_sec
+    print(f"  유예 설정 orphan_running_after_sec = {grace}초 (execution_settings 재사용)")
+    RUN_ID = "PSORPHAN1"
+    MEM_STORE.create_run(RUN_ID, target_table="MV_STAGE1", fingerprint="fpB")
+
+    stop = threading.Event()
+
+    def _run_fn(job):
+        rj.bind_run_id(job, RUN_ID, {"session_id": "sessB", "workflow_type": "INDIVIDUAL"})
+        rj.update_progress(job, processed_src=1234, processed_tgt=1200)   # 진행 신호 1회 발행
+        while not stop.is_set():
+            time.sleep(0.2)
+        return {"status": "READY", "run_id": RUN_ID}
+
+    job = rj.start_or_attach(fingerprint="fpB", meta={"session_id": "sessB",
+                                                      "workflow_type": "INDIVIDUAL"},
+                             run_fn=_run_fn)
+    time.sleep(1.0)
+    before = rj.run_status(RUN_ID)
+    _kill_thread(job["thread"])
+    job["thread"].join(timeout=5)
+    killed_at = time.time()
+    print(f"  thread 강제 종료 — alive={job['thread'].is_alive()} status={job['status']} "
+          f"(job 은 스스로 끝나지 않는 좀비 상태)")
+
+    timeline, confirmed_at = [], None
+    while time.time() - killed_at < grace + 20:
+        st = rj.run_status(RUN_ID)            # UI 폴링 경로가 곧 L1 스캔 지점
+        timeline.append({"t": round(time.time() - killed_at, 1), "status": st.get("status")})
+        if st.get("status") == rj.RECOVER_REQUIRED:
+            confirmed_at = time.time() - killed_at
+            break
+        time.sleep(2.0)
+
+    head = MEM_STORE.get_run(RUN_ID) or {}
+    actives = rj.active_runs("sessB", workflow_type="INDIVIDUAL")
+    ok = (confirmed_at is not None and grace <= confirmed_at <= grace + 8
+          and job.get("recover_reason") == rj.RECOVER_REASON_ORPHAN_RUNNING
+          and head.get("status") == "ORPHANED" and not actives)
+    R["results"]["B_l1_orphan"] = {
+        "grace_sec": grace,
+        "status_before_kill": before.get("status"),
+        "last_progress_at_before_kill": before.get("last_progress_at"),
+        "thread_alive_after_kill": job["thread"].is_alive(),
+        "confirmed_after_sec": (round(confirmed_at, 1) if confirmed_at is not None else None),
+        "status_after": job["status"], "recover_reason": job.get("recover_reason"),
+        "store_run_status": head.get("status"), "store_stop_reason": head.get("stop_reason"),
+        "active_runs_after": len(actives),
+        "timeline": timeline,
+        "verdict": "PASS" if ok else "FAIL",
+    }
+    print(f"  ORPHAN 확정까지 {confirmed_at}초 (유예 {grace}초) / job.status={job['status']} "
+          f"reason={job.get('recover_reason')}")
+    print(f"  store.finish_run 결과 status={head.get('status')} stop_reason={head.get('stop_reason')}")
+    print(f"  active_runs 잔여={len(actives)}건  판정={R['results']['B_l1_orphan']['verdict']}")
+    stop.set()
+    return ok
+
+
+# ── C. 회귀 — 유예보다 오래 도는 정상 job 은 절대 영향받지 않는다 ────────────────────────
+def part_c():
+    print("\n" + "=" * 78)
+    print("[C] 회귀 — 유예(30초)보다 오래 진행되는 정상 job 무영향 (가장 중요)")
+    print("=" * 78)
+    rj.clear_all()
+    grace = es.get_execution_settings().recovery.orphan_running_after_sec
+    RUN_ID = "PSHEALTHY1"
+    MEM_STORE.create_run(RUN_ID, target_table="MV_STAGE1_OK", fingerprint="fpC")
+    stop = threading.Event()
+    DURATION = grace + 15                       # 유예보다 확실히 오래 진행
+
+    def _run_fn(job):
+        rj.bind_run_id(job, RUN_ID, {"session_id": "sessC", "workflow_type": "INDIVIDUAL"})
+        n, t0 = 0, time.time()
+        while not stop.is_set() and time.time() - t0 < DURATION:
+            n += 500
+            rj.update_progress(job, processed_src=n, processed_tgt=n)   # 진행 신호 정상 발행
+            time.sleep(1.0)
+        return {"status": "READY", "run_id": RUN_ID}
+
+    job = rj.start_or_attach(fingerprint="fpC", meta={"session_id": "sessC",
+                                                      "workflow_type": "INDIVIDUAL"},
+                             run_fn=_run_fn)
+    seen, t0 = [], time.time()
+    while time.time() - t0 < DURATION + 3:
+        st = rj.run_status(RUN_ID)              # 폴링마다 L1 스캔이 돈다
+        seen.append(st.get("status"))
+        if st.get("status") not in rj._ACTIVE:
+            break
+        time.sleep(1.0)
+    job["thread"].join(timeout=20)
+    head = MEM_STORE.get_run(RUN_ID) or {}
+    bad = [s for s in seen if s not in (rj.PREPARING, rj.READY)]
+    ok = (not bad and job["status"] == rj.READY and head.get("status") != "ORPHANED"
+          and job.get("recover_reason") is None and job.get("thread_dead_seen_at") is None)
+    R["results"]["C_healthy_untouched"] = {
+        "run_duration_sec": DURATION, "grace_sec": grace, "poll_count": len(seen),
+        "unexpected_status": bad, "final_status": job["status"],
+        "recover_reason": job.get("recover_reason"),
+        "thread_dead_seen_at": job.get("thread_dead_seen_at"),
+        "store_run_status": head.get("status"),
+        "verdict": "PASS" if ok else "FAIL",
+    }
+    print(f"  {DURATION}초 진행(유예 {grace}초 초과) / 폴링 {len(seen)}회 / 예상외 상태 {bad}")
+    print(f"  최종 status={job['status']}  판정={R['results']['C_healthy_untouched']['verdict']}")
+    return ok
+
+
+def main() -> int:
+    R["env"] = {"internal_network": "unreachable(192.168.0.150/151/211 timed out)",
+                "neon": "quota exceeded(서버측 거부)",
+                "substitute": "실 엔진·실 route·실 job thread in-process 구동(가짜: DB conn/chunk 어댑터)"}
+    a = part_a()
+    b = part_b()
+    c = part_c()
+    R["verdict"] = "PASS" if (a and b and c) else "FAIL"
+    print("\n" + "=" * 78)
+    print(f"종합 판정: {R['verdict']}  (A={a} B={b} C={c})")
+    print("=" * 78)
+    os.makedirs(SHOT, exist_ok=True)
+    out = os.path.join(SHOT, "stage1_progress_timestamp_verify.json")
+    with open(out, "w", encoding="utf-8") as f:
+        json.dump(R, f, ensure_ascii=False, indent=1)
+    print("결과 저장:", out)
+    return 0 if R["verdict"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
