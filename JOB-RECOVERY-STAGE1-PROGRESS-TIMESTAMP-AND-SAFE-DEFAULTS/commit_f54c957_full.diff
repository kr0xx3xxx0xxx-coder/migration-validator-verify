+# ── 4. 회귀 — 정상 진행 중 job 무영향(가장 중요) ────────────────────────────────────────
+def test_running_job_never_touched():
+    hold = threading.Event()
+    job = _mk_job("fpS4", "RUNS4", hold)
+    try:
+        time.sleep(0.2)
+        rj.update_progress(job, processed_src=100)
+        store = _FakeStore()
+        # 유예보다 한참 뒤 시각으로 스캔해도 thread 가 살아 있으면 대상이 아니다
+        for offset in (1, 60, 3600, 86400):
+            assert rj.reclaim_dead_thread_jobs(now=time.time() + offset, store=store) == []
+            assert job["status"] == rj.PREPARING
+        assert store.finished == []
+        assert job.get("thread_dead_seen_at") is None
+        assert any(r["run_id"] == "RUNS4" for r in rj.active_runs("sessS1"))
+        assert rj.run_status("RUNS4")["status"] == rj.PREPARING
+    finally:
+        hold.set()
+
