      "id": "C",
      "label": "형태 복잡(CTE+JOIN+윈도우) · 실제 비쌈",
      "shape_wrapping": true,
      "src_sql": "SELECT * FROM (\nWITH ranked AS (\n  SELECT\n    x.ID,\n    x.C_NUM,\n    CASE WHEN t.AMT IS NULL THEN x.C_NUM_PS ELSE x.C_NUM_PS + t.AMT END AS C_NUM_PS,\n    ROW_NUMBER() OVER (PARTITION BY x.C_CHAR ORDER BY x.ID) AS rn\n  FROM NXDNP.MV_ORA_XDIFF_SRC x\n  LEFT JOIN NXDNP.MV_ORA_TEST_SRC t\n    ON MOD(x.ID, 300) + 1 = t.ORDER_ID\n)\nSELECT\n  ID AS ID,\n  C_NUM AS C_NUM,\n  C_NUM_PS AS C_NUM_PS\nFROM ranked\nWHERE\n  rn >= 1\n) mv_reimport_src",
