 function mvCountGateSideExport(side) {
   if (!window.confirm('비어 있지 않은 쪽 전체 레코드를 CSV 로 스트리밍 생성합니다(요청 시에만 — 서버 저장 없음).\\n대상 행 수가 많으면 시간이 걸릴 수 있습니다. 계속하시겠습니까?')) return;
