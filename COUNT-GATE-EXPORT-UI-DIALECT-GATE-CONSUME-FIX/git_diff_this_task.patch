-    });
+    .then(function(resp){
+      var ct = (resp.headers.get('Content-Type') || '').toLowerCase();
+      /* JSON 이면 CSV 가 아니라 서버 차단/오류다 — 파일로 저장하지 않고 화면에 표시한다.
