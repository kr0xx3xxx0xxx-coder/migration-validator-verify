+# ── connection 재사용 (CHUNK-CHECKPOINT-CONNECTION-REUSE-FIX) ────────────────────
+#   기존에는 write 1회마다 connect + CREATE TABLE IF NOT EXISTS + ALTER TABLE 3회 + PRAGMA 를
+#   반복해, 실측 8.15 ms 중 6.8 ms(83%)가 이 부대작업이었다. 아래 두 가지로 제거한다.
+#     ① 스키마 DDL 은 DB 파일당 최초 1회만(_SCHEMA_READY) — 이후 write 는 UPDATE+commit 만.
+#     ② connection 은 **스레드별로** 재사용(_LOCAL) — sqlite3 connection 은 기본(check_same_thread=True)
+#        스레드 간 공유가 금지되므로 전역 1개를 공유하지 않고 스레드마다 1개를 캐시한다.
+#        일괄검증처럼 여러 job 스레드가 동시에 write 해도 각자 자기 connection 만 쓰며(공유 없음),
+#        파일 단위 직렬화는 기존 _LOCK(모든 함수가 획득) + WAL + busy_timeout 이 그대로 담당한다.
+#   _DB_PATH 는 테스트에서 교체되므로 캐시 키를 경로로 둔다(경로가 바뀌면 새 connection).
+_LOCAL = threading.local()          # 스레드별 {db_path: sqlite3.Connection}
+_SCHEMA_READY: set[str] = set()     # DDL 적용 완료 DB 경로(_LOCK 보호)
+
+
+def _thread_conns():
+    """현재 스레드의 connection 캐시(dict) — 다른 스레드와 공유되지 않는다."""
+    d = getattr(_LOCAL, "conns", None)
+    if d is None:
+        d = {}
+        _LOCAL.conns = d
+    return d
+
+
 def _conn():
-    os.makedirs(os.path.dirname(_DB_PATH), exist_ok=True)
-    c = sqlite3.connect(_DB_PATH, timeout=30)
+    """현재 스레드 전용 connection 반환(재사용). 스키마 DDL 은 DB 파일당 최초 1회만 실행한다.
+    호출자는 _LOCK 을 보유한 상태여야 하며(모든 공개 함수가 그렇다), 반환된 connection 을 close 하지 않는다."""
+    path = str(_DB_PATH)
+    conns = _thread_conns()
+    c = conns.get(path)
+    if c is not None:
+        return c
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    c = sqlite3.connect(path, timeout=30)
     c.row_factory = sqlite3.Row
     c.execute("PRAGMA journal_mode=WAL")
     c.execute("PRAGMA busy_timeout=5000")
+    with _LOCK:                                   # RLock — 이미 보유 중이어도 안전(재진입)
+        if path not in _SCHEMA_READY:
+            _init_schema(c)
+            _SCHEMA_READY.add(path)
+    conns[path] = c
+    return c
+
+
+def _init_schema(c):
+    """테이블 생성 + 누락 컬럼 보강(멱등) — DB 파일당 1회만 호출된다."""
     c.execute(_DDL)
     for _col, _sql in _ADD_COLS:
         try:
             c.execute(_sql)
         except Exception:  # noqa: BLE001
             pass
-    return c
+    c.commit()
+
+
+def _discard_conn():
+    """현재 스레드의 캐시 connection 폐기 + 스키마 플래그 해제(자가복구용)."""
+    path = str(_DB_PATH)
+    c = _thread_conns().pop(path, None)
+    if c is not None:
+        try:
+            c.close()
+        except Exception:  # noqa: BLE001
+            pass
+    with _LOCK:
+        _SCHEMA_READY.discard(path)
+
+
+def _with_conn(fn):
+    """_LOCK 보유 상태에서 스레드 connection 으로 fn(c) 실행.
+    DB 파일이 외부에서 삭제/재생성돼 테이블이 사라진 경우(기존 코드는 매 호출 DDL 이라 자동 복구됐다)
+    connection 을 버리고 스키마를 다시 만든 뒤 1회만 재시도해 같은 내구성을 유지한다."""
+    with _LOCK:
+        try:
+            return fn(_conn())
+        except sqlite3.OperationalError as e:
+            if "no such table" not in str(e).lower():
+                raise
+            _discard_conn()
+            return fn(_conn())
+
+
+def conn_debug_info():
+    """[진단 전용] 현재 스레드의 재사용 connection 식별자와 스키마 초기화 완료 경로 수.
+    current_conn_id 는 현재 _DB_PATH 의 캐시 connection(없으면 None) — 새로 열지 않는다."""
+    conns = _thread_conns()
+    cur = conns.get(str(_DB_PATH))
+    return {"thread": threading.current_thread().name,
+            "thread_conn_ids": [id(c) for c in conns.values()],
+            "current_conn_id": (id(cur) if cur is not None else None),
+            "schema_ready_paths": len(_SCHEMA_READY), "db_path": str(_DB_PATH)}
 
 
