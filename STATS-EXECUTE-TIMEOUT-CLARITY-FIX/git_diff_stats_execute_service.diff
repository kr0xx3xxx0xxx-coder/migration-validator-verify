+def _timeout_error_message(side_label: str) -> str:
+    """통계 SQL 실행 타임아웃 오류 메시지(STATS-EXECUTE-TIMEOUT-CLARITY).
+
+    타임아웃은 '일시적 장애'가 아니라 '실행마다 동일하게 적용되는 고정 상한'이다.
+    같은 SQL·같은 데이터라면 재시도해도 같은 지점에서 잘리는 영구 실패이므로,
+    사용자가 의미 없는 재시도를 반복하지 않도록 아래 3가지를 함께 알린다.
+      ① 재시도해도 동일 실패 가능성이 높다는 사실
+      ② 현재 적용된 제한값(초 + 환경변수명/ms 원값)
+      ③ 상향 방법과 대안(대상 축소)
+    ※ 판정 로직·타임아웃 값 자체는 변경하지 않는다(문구 전용).
+    첫 문장은 기존 문구를 그대로 보존한다(기존 표시/계약 하위호환).
+
+    side_label: '원본' 또는 '목적지'
+    """
+    _sec = EXECUTE_STATEMENT_TIMEOUT_MS / 1000.0
+    return (
+        f"{side_label} 통계 SQL 실행 시간이 제한을 초과했습니다."
+        f"\n현재 제한: {_sec:g}초 (환경변수 MV_EXECUTE_STATEMENT_TIMEOUT_MS = {EXECUTE_STATEMENT_TIMEOUT_MS} ms)"
+        "\n이 제한은 실행마다 동일하게 적용되는 고정값이므로, 같은 SQL·같은 데이터로는 "
+        "재시도해도 동일하게 실패할 가능성이 높습니다. 단순 재시도 대신 아래 조치를 권장합니다."
+        "\n① 제한 상향: 서버 환경변수 MV_EXECUTE_STATEMENT_TIMEOUT_MS 를 더 큰 값(밀리초)으로 "
+        f"설정한 뒤 서버를 재기동하세요. (예: 300000 = 300초 / 현재 {EXECUTE_STATEMENT_TIMEOUT_MS})"
+        "\n② 대상 축소: WHERE 조건으로 검증 범위를 줄이거나 GROUP BY·SUM 컬럼 수를 줄여 "
+        "쿼리 부담을 낮추세요."
+    )
+
+
